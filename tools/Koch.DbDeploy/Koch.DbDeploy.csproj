<Project Sdk="Microsoft.NET.Sdk">

  <!-- Applies db/<service>/*.sql in file-name order, as CI's deploy identity (Entra, no password). The scripts are
       idempotent, so this runs on every deploy. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

</Project>
