<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every sample of the photo events Recipes ever published: Media must read them all (consumer side of the
         contract; the producer side is tests/Koch.Recipes.Tests/OutboxTests.cs). -->
    <None Include="..\Koch.Recipes.Tests\Contracts\event-photo-attached\*.json" LinkBase="Contracts\event-photo-attached" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Koch.Recipes.Tests\Contracts\event-photo-detached\*.json" LinkBase="Contracts\event-photo-detached" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Koch.Media\Koch.Media.csproj" />
  </ItemGroup>

</Project>
