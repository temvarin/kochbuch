<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Kusto.Language" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NetArchTest.eNhancedEdition" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The compiled code of every deployable and library: the rules read their dependencies from it. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Koch.App\Koch.App.csproj" />
    <ProjectReference Include="..\..\src\Koch.Gateway\Koch.Gateway.csproj" />
    <ProjectReference Include="..\..\src\Koch.Recipes\Koch.Recipes.csproj" />
    <ProjectReference Include="..\..\src\Koch.Shopping\Koch.Shopping.csproj" />
    <ProjectReference Include="..\..\src\Koch.Media\Koch.Media.csproj" />
  </ItemGroup>

  <!-- The saved queries (infra/queries), checked against the Application Insights tables in QueryTests. -->
  <ItemGroup>
    <None Include="..\..\infra\queries\*.kql" LinkBase="queries" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
