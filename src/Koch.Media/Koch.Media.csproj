<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Media service: an Azure Function (Flex Consumption) that turns uploaded photos into renditions. Photo work is
       asynchronous, bursty and heavy, unlike the HTTP services, so it runs where it costs nothing while idle
       (docs/adr/0001, 0006). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.ServiceBus" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.OpenTelemetry" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Koch.Media.Contracts\Koch.Media.Contracts.csproj" />
    <ProjectReference Include="..\Koch.Media.Imaging\Koch.Media.Imaging.csproj" />
    <!-- The photo events Media consumes; their producer, Recipes, owns the contract (docs/adr/0008). -->
    <ProjectReference Include="..\Koch.Recipes.Events\Koch.Recipes.Events.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="host.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Koch.Media.Tests" />
  </ItemGroup>

</Project>
