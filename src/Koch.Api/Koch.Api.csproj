<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Backend API: owns Recipes and Shopping sync over Azure SQL. Internal ingress only (behind Koch.Gateway). -->
  <PropertyGroup>
    <ContainerRepository>kochbuch-api</ContainerRepository>
    <ContainerFamily>noble-chiseled</ContainerFamily>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Koch.Contracts\Koch.Contracts.csproj" />
    <ProjectReference Include="..\Koch.Domain\Koch.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Koch.Services.Tests" />
    <InternalsVisibleTo Include="Koch.App.Tests" />
  </ItemGroup>

</Project>
