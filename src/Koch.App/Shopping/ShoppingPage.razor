@page "/einkauf"
@inherits LiveComponent
@inject ShoppingService Shopping

@* The household's one shopping list (docs/adr/0014). Recipes come onto it from their page; this adds anything else. *@
<PageTitle>Einkaufsliste – Kochbuch</PageTitle>
@{
    var lines = Shopping.Lines;
}

<div class="page-head">
    <div class="title-row">
        <h1 class="display">Einkaufsliste</h1>
        @if (lines.Count > 0)
        {
            <MoreMenu Label="Mehr: Erledigte leeren, Liste leeren">
                <button type="button" data-testid="remove-checked" disabled="@(!lines.Any(l => l.Checked))" @onclick="Shopping.RemoveChecked">Erledigte leeren</button>
                @if (confirmClear)
                {
                    <button type="button" class="danger" data-testid="clear-confirm" @onclick="Clear">Wirklich alles leeren</button>
                }
                else
                {
                    <button type="button" class="danger" data-testid="clear" @onclick="() => confirmClear = true" @onclick:stopPropagation>Liste leeren</button>
                }
            </MoreMenu>
        }
    </div>
    @if (Shopping.OpenRecipes.Count > 0)
    {
        <p class="muted" data-testid="for">Für @string.Join(", ", Shopping.OpenRecipes)</p>
    }
</div>
<SyncBanner />

<form class="add-line" @onsubmit="AddByHand">
    <label class="field">
        <span class="visually-hidden">Noch etwas</span>
        <input @bind="byHand" placeholder="Noch etwas, z. B. Milch" maxlength="@Koch.Shopping.Domain.ShoppingItem.MaxName" data-testid="by-hand" />
    </label>
    <button type="submit" class="btn primary" aria-label="Hinzufügen"><Icon Name="plus" /></button>
</form>

@if (lines.Count == 0)
{
    <p class="empty">Die Liste ist leer. Auf einer Rezeptseite kommt mit „Auf die Liste“ alles darauf, was das Rezept braucht.</p>
}
else
{
    <section class="card list shopping-card">
        @if (lines.Any(l => !l.Checked))
        {
            <ul class="shopping" data-testid="open">
                @foreach (var line in lines.Where(l => !l.Checked))
                {
                    <li><ShoppingLineView Line="line" OnToggle="() => Shopping.Check(line.Key, true)" /></li>
                }
            </ul>
        }
        @if (lines.Any(l => l.Checked))
        {
            <h2 class="in-trolley">Im Wagen · @lines.Count(l => l.Checked)</h2>
            <ul class="shopping" data-testid="checked">
                @foreach (var line in lines.Where(l => l.Checked))
                {
                    <li><ShoppingLineView Line="line" OnToggle="() => Shopping.Check(line.Key, false)" /></li>
                }
            </ul>
        }
    </section>
}

@code {
    private string byHand = "";
    private bool confirmClear;

    private void AddByHand()
    {
        if (byHand.Trim().Length == 0) return;
        Shopping.AddByHand(byHand);
        byHand = "";
    }

    private void Clear()
    {
        Shopping.Clear();
        confirmClear = false;
    }
}
