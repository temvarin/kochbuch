@page "/einkauf/{Id:guid}"
@inherits LiveComponent
@inject ShoppingService Shopping
@inject NavigationManager Nav

@if (Shopping.Find(Id) is not { } list)
{
    <TopBar Title="Einkauf" Back="einkauf" />
    <p class="empty">Diese Liste gibt es nicht (mehr). <a href="einkauf">Zu den Listen</a></p>
}
else
{
    var lines = Shopping.Lines(Id);
    <TopBar Title="@list.Title" Back="einkauf" />
    <SyncBanner />

    <a class="btn" href="einkauf/@Id/rezepte" data-testid="add-recipes">Rezepte hinzufügen</a>
    <form class="add-by-hand" @onsubmit="AddByHand">
        <label class="field">
            <span>Noch etwas</span>
            <input @bind="byHand" placeholder="z. B. Milch" maxlength="@Koch.Shopping.Domain.ShoppingItem.MaxName" data-testid="by-hand" />
        </label>
        <button type="submit" class="btn">Hinzufügen</button>
    </form>

    @if (lines.Count == 0)
    {
        <p class="empty">Die Liste ist leer.</p>
    }
    @foreach (var aisle in lines.Where(l => !l.Checked).GroupBy(l => l.Aisle))
    {
        <div class="section"><h2>@aisle.Key.Name()</h2></div>
        <section class="card list">
            <ul class="shopping" data-testid="open">
                @foreach (var line in aisle)
                {
                    <li><ShoppingLineView Line="line" OnToggle="() => Shopping.Check(Id, line.Key, true)" /></li>
                }
            </ul>
        </section>
    }

    @if (lines.Any(l => l.Checked))
    {
        <div class="section"><h2>Im Wagen</h2></div>
        <section class="card list">
            <ul class="shopping" data-testid="checked">
                @foreach (var line in lines.Where(l => l.Checked))
                {
                    <li><ShoppingLineView Line="line" OnToggle="() => Shopping.Check(Id, line.Key, false)" /></li>
                }
            </ul>
        </section>
        <button class="btn" data-testid="remove-checked" @onclick="() => Shopping.RemoveChecked(Id)">Erledigtes entfernen</button>
    }

    <a class="btn" href="zutaten">Wo im Laden? Gänge ändern</a>
    @if (confirmRemove)
    {
        <button class="btn danger" data-testid="remove-list-confirm" @onclick="RemoveList">Wirklich die ganze Liste löschen</button>
    }
    else
    {
        <button class="btn danger" data-testid="remove-list" @onclick="() => confirmRemove = true">Liste löschen</button>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private string byHand = "";
    private bool confirmRemove;

    private void AddByHand()
    {
        if (byHand.Trim().Length == 0) return;
        Shopping.AddByHand(Id, byHand);
        byHand = "";
    }

    private void RemoveList()
    {
        Shopping.RemoveList(Id);
        Nav.NavigateTo("einkauf");
    }
}
