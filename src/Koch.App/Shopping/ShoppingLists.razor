@page "/einkauf"
@inherits LiveComponent
@inject ShoppingService Shopping
@inject NavigationManager Nav

<TopBar Title="Einkauf" />
<SyncBanner />

@if (Shopping.Lists.Count == 0)
{
    <p class="empty">Noch keine Einkaufsliste. Wähle Rezepte, und die Mengen werden zusammengerechnet.</p>
}
else
{
    <section class="card list">
        <ul>
            @foreach (var list in Shopping.Lists)
            {
                var open = Shopping.Lines(list.Id).Count(l => !l.Checked);
                <li>
                    <a class="line" href="einkauf/@list.Id">
                        <span class="name"><b>@list.Title</b></span>
                        <span class="muted">@(open == 0 ? "alles erledigt" : open == 1 ? "1 offen" : $"{open} offen")</span>
                    </a>
                </li>
            }
        </ul>
    </section>
}
<button class="btn primary" data-testid="new-list" @onclick="NewList">Neue Liste aus Rezepten</button>

@code {
    private void NewList()
    {
        var id = Shopping.NewList();
        Nav.NavigateTo($"einkauf/{id}/rezepte");
    }
}
