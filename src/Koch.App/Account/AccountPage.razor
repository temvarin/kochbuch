@page "/konto"
@inherits LiveComponent
@inject AccountService Account
@inject SyncOverview Sync
@inject NavigationManager Nav
@inject TimeProvider Clock

<TopBar Title="Konto und Abgleich" Back="" />

<section class="card">
    @switch (Account.Status)
    {
        case AccountStatus.SignedIn:
            <div class="setting"><span>Angemeldet als</span><span class="account">@Account.Me!.Name</span></div>
            break;
        case AccountStatus.NotMember:
            <p>Angemeldet als <strong>@Account.Me!.Name</strong>, aber noch nicht freigeschaltet.</p>
            <p class="hint">Deine Id für die Mitgliederliste: <code>@Account.Me.Id</code></p>
            break;
        case AccountStatus.SignedOut:
            <p>Nicht angemeldet. Rezepte bleiben auf diesem Handy, bis du dich anmeldest.</p>
            <button class="btn primary" @onclick="SignIn">Anmelden</button>
            break;
        case AccountStatus.Unreachable:
            <p>Keine Verbindung. Alles, was du änderst, bleibt auf dem Handy und wird später abgeglichen.</p>
            break;
        default:
            <p class="muted">Wird geprüft …</p>
            break;
    }
</section>

@if (Account.Status == AccountStatus.SignedIn)
{
    <section class="card">
        <div class="setting">
            <span>Abgleich</span>
            <span data-testid="sync-status">@StatusText</span>
        </div>
        <button class="btn" disabled="@(Sync.Status == SyncStatus.Syncing || !Sync.CanSync)" @onclick="Sync.SyncNowAsync">
            Jetzt abgleichen
        </button>
    </section>
}

@code {
    private string StatusText => Sync.Describe(Clock.GetUtcNow());

    private void SignIn() => Nav.NavigateTo(AccountService.SignInUrl, forceLoad: true);
}
