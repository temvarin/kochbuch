@page "/zutaten"
@inherits LiveComponent
@inject RecipeService Recipes

<TopBar Title="Zutaten und Gänge" Back="einkauf" />

<p class="muted">Wo steht was im Laden? Die Einkaufslisten folgen dieser Reihenfolge – auf beiden Handys.</p>
@if (Recipes.Ingredients.Count == 0)
{
    <p class="empty">Noch keine Zutaten. Sie kommen mit den Rezepten.</p>
}
else
{
    <section class="card">
        @foreach (var ingredient in Recipes.Ingredients)
        {
            <label class="setting">
                <span>@ingredient.Name</span>
                <select value="@ingredient.Aisle" data-testid="aisle"
                        @onchange="e => Recipes.SetAisle(ingredient.Name, Enum.Parse<Aisle>((string)e.Value!))">
                    @foreach (var aisle in Aisles.InOrder)
                    {
                        <option value="@aisle">@aisle.Name()</option>
                    }
                </select>
            </label>
        }
    </section>
}
