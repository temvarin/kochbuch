@page "/"
@inherits LiveComponent
@inject RecipeService Recipes
@inject ShoppingService Shopping
@inject SyncOverview Sync
@inject AccountService Account
@inject TimeProvider Clock

<PageTitle>Rezepte – Kochbuch</PageTitle>

<div class="page-head">
    <div class="status-row">
        @if (Account.Status == AccountStatus.SignedIn)
        {
            <span class="sync-line" data-testid="sync-line">@Sync.Describe(Clock.GetUtcNow())</span>
        }
        <a class="icon-btn" href="konto" aria-label="Konto und Abgleich"><Icon Name="user" /></a>
    </div>
    <h1 class="display">Was kochen wir heute?</h1>
</div>
<SyncBanner />

@if (Recipes.All.Count == 0)
{
    <p class="empty">Noch keine Rezepte. Das erste ist schnell angelegt: unten rechts auf +.</p>
}
else
{
    <label class="search">
        <Icon Name="search" />
        <input type="search" placeholder="Rezept oder Zutat suchen" aria-label="Suchen" @bind="search" @bind:event="oninput" data-testid="search" />
    </label>
    @if (Found.Count == 0)
    {
        <p class="empty">Nichts gefunden.</p>
    }
    else
    {
        <ul class="tiles">
            @foreach (var recipe in Found)
            {
                <li>
                    <a class="tile" href="rezept/@recipe.Id">
                        <RecipeCover Recipe="recipe" />
                        <b>@recipe.Title</b>
                        <span class="muted">@recipe.Servings @(recipe.Servings == 1 ? "Portion" : "Portionen")</span>
                    </a>
                </li>
            }
        </ul>
    }
}

<div class="dock">
    <a class="list-bar" href="einkauf" data-testid="list-bar">
        <Icon Name="list" />
        <span>Einkaufsliste</span>
        <span class="count">@(Shopping.Open == 0 ? "leer" : $"{Shopping.Open} offen")</span>
    </a>
    <a class="fab" href="rezept/neu" aria-label="Neues Rezept"><Icon Name="plus" /></a>
</div>

@code {
    private string search = "";

    // In the title or any ingredient, case ignored.
    private IReadOnlyList<Recipe> Found => search.Trim() is { Length: > 0 } term
        ? [.. Recipes.All.Where(r => r.Title.Contains(term, StringComparison.OrdinalIgnoreCase)
            || r.Lines.Any(l => l.Ingredient.Contains(term, StringComparison.OrdinalIgnoreCase)))]
        : Recipes.All;
}
