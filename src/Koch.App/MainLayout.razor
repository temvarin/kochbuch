@inherits LayoutComponentBase
@inject Browser Browser
@inject SyncOverview Sync

@* Pages with a back arrow fill the top bar; the main pages and the recipe page bring their own header, and it stays
   empty and hidden (styles.css). *@
<header class="topbar">
    <SectionOutlet SectionName="@TopBar.Section" />
</header>
<main>
    @Body
</main>
<nav class="tabbar" aria-label="Bereiche">
    <NavLink href="" Match="NavLinkMatch.All"><span class="tab-icon"><Icon Name="book" /></span>Rezepte</NavLink>
    <NavLink href="einkauf"><span class="tab-icon"><Icon Name="cart" /></span>Einkauf</NavLink>
</nav>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _ = Browser.ProtectStorageAsync(); // the browser answers in its own time, and nothing waits for it
        await Browser.WhenVisibleAsync(Sync.ResumeAsync);
        await Sync.StartAsync();
    }
}
