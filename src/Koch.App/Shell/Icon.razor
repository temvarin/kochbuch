@* Line icons, drawn in the text colour. Decorative: the button or link around one carries the label. *@
<svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
    @switch (Name)
    {
        case "book":
            <path d="M4 5a2 2 0 012-2h13v16H6a2 2 0 00-2 2z" /><path d="M4 19V5" />
            break;
        case "cart":
            <path d="M3 4h2l2.4 11.2a2 2 0 002 1.6h7.7a2 2 0 002-1.5L21 8H6" /><circle cx="10" cy="20" r="1.3" /><circle cx="17" cy="20" r="1.3" />
            break;
        case "list":
            <path d="M9 6h11M9 12h11M9 18h11" /><path d="M4 6l1 1 2-2M4 12l1 1 2-2M4 18l1 1 2-2" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "back":
            <path d="M15 5l-7 7 7 7" />
            break;
        case "close":
            <path d="M6 6l12 12M18 6L6 18" />
            break;
        case "more":
            <circle cx="5" cy="12" r="1.2" /><circle cx="12" cy="12" r="1.2" /><circle cx="19" cy="12" r="1.2" />
            break;
        case "play":
            <path d="M8 5v14l11-7z" />
            break;
        case "user":
            <circle cx="12" cy="8" r="4" /><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" />
            break;
        case "search":
            <circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" />
            break;
        case "check":
            <path d="M5 12l5 5 9-10" />
            break;
    }
</svg>

@code {
    /// <summary>book, cart, list, plus, back, close, more, play, user, search, check.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";
}
