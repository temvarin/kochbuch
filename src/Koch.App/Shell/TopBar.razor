@inject AppText Text

<PageTitle>@Text.PageTitle(Title)</PageTitle>
<SectionContent SectionName="@Section">
    @if (Back is not null)
    {
        <a class="icon-btn" href="@Back" aria-label="@Text.Pick("Zurück", "Назад")">←</a>
    }
    <div class="titles"><h1>@Title</h1></div>
    @if (Back is null)
    {
        <a class="icon-btn end-btn" href="konto" aria-label="@Text.Pick("Konto und Abgleich", "Аккаунт и синхронизация")">⚙</a>
    }
</SectionContent>

@code {
    public const string Section = "topbar";

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public string? Back { get; set; }
}
