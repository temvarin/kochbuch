<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The Recipes service: the system of record for recipes. Reachable only through the gateway. -->
  <PropertyGroup>
    <!-- Built as a container image without Docker: dotnet publish /t:PublishContainer (docs/deployment.md). -->
    <ContainerRepository>kochbuch-recipes</ContainerRepository>
    <ContainerFamily>noble-chiseled</ContainerFamily>
    <!-- Precompiled, so that a replica started from zero answers sooner. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!-- The outbox relay publishes to Service Bus with the service's managed identity (docs/adr/0008). -->
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Messaging.ServiceBus" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Koch.Recipes.Domain\Koch.Recipes.Domain.csproj" />
    <ProjectReference Include="..\Koch.Recipes.Events\Koch.Recipes.Events.csproj" />
    <ProjectReference Include="..\Koch.ServiceDefaults\Koch.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Koch.Recipes.Tests" />
  </ItemGroup>

</Project>
